  /// Não inventar union fechada aqui.
  identificador_fiscal String?  @db.VarChar(20)
  nome                 String?  @db.VarChar(200)
  /// MCD-F9007 (Errata controlada nº2 do ADR-001, ADR-D017) — momento do
  /// registro canônico no armazenamento CONTIFISC.
  registrado_em        DateTime @db.Timestamptz

  receitas     Receita[]
  eventos_irpf EventoIRPF[]

  @@map("fonte_pagadora")
}

// ============================================================================
// COT-OBJ-013 -> MCD-F8001..F8005 -> CDC-PLN-001 -> DST-T016
// Cenário Tributário: simulação isolada dos fatos oficiais.
// ============================================================================
model CenarioTributario {
  id                                  String   @id @db.Uuid
  nome                                String   @db.VarChar(120)
  valor_carga_tributaria_projetada    Decimal? @db.Decimal(18, 2)
  valor_economia_tributaria_projetada Decimal? @db.Decimal(18, 2)
  unidade_economica_id                String   @db.Uuid
  /// MCD-F9007 (Errata controlada nº2 do ADR-001, ADR-D017) — momento do
  /// registro canônico no armazenamento CONTIFISC.
  registrado_em                       DateTime @db.Timestamptz

  unidade_economica UnidadeEconomica @relation(fields: [unidade_economica_id], references: [id], onDelete: Restrict)

  resultados_calculo ResultadoCalculo[]

  @@map("cenario_tributario")
}

// ============================================================================
// COT-OBJ-014 -> MCD-F8201..F8209 -> CDC-CAL-001 -> DST-T017
// Resultado de Cálculo: resultado reproduzível (snapshot/engine/regras).
// ============================================================================
model ResultadoCalculo {
  id                    String   @id @db.Uuid
  cenario_tributario_id String?  @db.Uuid
  input_snapshot_hash   String   @db.VarChar(128)
  engine_id             String   @db.VarChar(80)
  engine_version        String   @db.VarChar(20)
  /// Opaco até RGT-001 (ADR-GAP-005). Não é FK — nenhum modelo de regra existe ainda.
  rule_set_id           String   @db.VarChar(80)
  rule_set_version      String   @db.VarChar(20)
  /// `ADR-GAP-008` (Errata controlada nº2 do ADR-001): MCD-F9007
  /// (`registrado_em`) NÃO foi materializado neste model. A equivalência
  /// semântica entre `calculado_em` (momento do cálculo) e `registrado_em`
  /// (momento do registro canônico) não foi confirmada — não resolvido por
  /// inferência. `calculado_em` permanece como já estava, sem renomeação.
  calculado_em          DateTime @db.Timestamptz
  /// DST-E006 (fechado): PENDENTE | APROVADO | REJEITADO | AJUSTE_SOLICITADO.
  /// CHECK PostgreSQL obrigatório na migration futura (ADR-D010).
  status_revisao        String?  @db.Text
  /// MCD-F10004 (SEC-CHANGE-REQUEST-001 V1.1, ADR-001 V1.1 ADR-D022) --
  /// contexto de apuracao. Sempre presente, inclusive quando
  /// cenario_tributario_id tambem esta preenchido -- os dois campos NAO sao
  /// mutuamente exclusivos (nenhum XOR, CDC-REL-SEC-003). Quando ambos
  /// presentes, devem ser consistentes entre si (constraint de consistencia
  /// a decidir no ADR/PoC, nao implementada neste schema). Mutabilidade:
  /// IMUTAVEL (diferente dos outros 5 hospedeiros de MCD-F10004) --
  /// ResultadoCalculo e um snapshot reproduzivel; toda mudanca de contexto
  /// exige um NOVO ResultadoCalculo (novo id, novo input_snapshot_hash),
  /// nunca uma edicao do registro existente (MCD-001 V1.4 par.8.1,
  /// ADR-001 V1.1 par.13.2).
  unidade_economica_id  String   @db.Uuid

  /// Corrigido: Restrict (não Cascade). O ADR-001 §8 apenas menciona
  /// "possível cascade interno do cenário após política explícita" — essa
  /// política explícita ainda não existe. Restrict é a postura conservadora
  /// padrão até uma decisão futura autorizar Cascade explicitamente.
  cenario_tributario CenarioTributario? @relation(fields: [cenario_tributario_id], references: [id], onDelete: Restrict)
  unidade_economica  UnidadeEconomica   @relation(fields: [unidade_economica_id], references: [id], onDelete: Restrict)

  @@index([unidade_economica_id])
  @@map("resultado_calculo")
}

// ============================================================================
// COT-OBJ-015 -> MCD-F8601..F8604 -> CDC-CFD-001 -> DST-T018
// Conflito de Dados: divergência auditável entre fontes/fatos candidatos.
// ============================================================================
model ConflitoDado {
  id              String   @id @db.Uuid
  /// DST-E007 (fechado): ABERTO | EM_ANALISE | RESOLVIDO | DESCARTADO. CHECK
  /// PostgreSQL obrigatório na migration futura (ADR-D010: TEXT + CHECK, não ENUM nativo).
  status_conflito String   @db.Text
  /// DST-GAP-009 — Enum/Ref aberto (catálogo de tipo_conflito ainda não fechado). Obrigatório.
  tipo_conflito   String   @db.Text
  descricao       String?  @db.Text
  /// MCD-F9007 (Errata controlada nº2 do ADR-001, ADR-D017) — momento do
  /// registro canônico no armazenamento CONTIFISC.
  registrado_em   DateTime @db.Timestamptz
  /// MCD-F10003 (SEC-CHANGE-REQUEST-001 V1.1, ADR-001 V1.1 ADR-D023) --
  /// carimbado pelo servico de reconciliacao no momento da criacao -- nunca
  /// escolhido arbitrariamente, nunca derivado da referencia polimorfica de
  /// ConflitoDadoItem (objeto_id/tipo_objeto). Um ConflitoDado pode envolver
  /// itens de mais de uma UnidadeEconomica do mesmo tenant, mas nunca de
  /// tenants diferentes (CDC-REL-SEC-002). Imutavel.
  tenant_id       String   @db.Uuid

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Restrict)

  itens ConflitoDadoItem[]

  @@index([tenant_id])
  @@map("conflito_dado")
}

// ============================================================================
// COT-SUP-004 -> MCD-F8650..F8657 -> CDC-CFD-002 -> DST-T019
// Estrutura de suporte de auditoria — NÃO é objeto tributário de negócio.
//
// `objeto_id`/`tipo_objeto`: EXCEÇÃO POLIMÓRFICA CONTROLADA DE RECONCILIAÇÃO
// (domínio de qualidade/reconciliação de dados), prevista pelo MCD/CDC/COT.
// NÃO existe FK PostgreSQL genérica para `objeto_id` — é fisicamente
// impossível apontar uma única FK para múltiplas tabelas de destino. A
// integridade dessa referência é validada pela camada de domínio/aplicação
// e auditada, não pelo banco. `tipo_objeto` permanece Enum/Ref aberto
// (DST-GAP-012) enquanto o catálogo correspondente não for fechado.
//
// Este padrão é PROIBIDO como mecanismo de ownership de Receita, Vinculo ou
// qualquer outro objeto financeiro/tributário — esses sempre usam FK real
// (com XOR quando aplicável). Não reutilizar esta exceção fora do domínio de
// auditoria/reconciliação/revisão (ver também RevisaoTecnica, abaixo).
// ============================================================================
model ConflitoDadoItem {
  id                   String   @id @db.Uuid
  conflito_dado_id     String   @db.Uuid
  /// DST-GAP-012 — Enum/Ref aberto, restrito ao domínio de auditoria. Obrigatório.
  tipo_objeto          String   @db.Text
  /// Exceção polimórfica controlada de RECONCILIAÇÃO (sem FK): pode referenciar
  /// qualquer objeto canônico conforme `tipo_objeto`. Validação fica no
  /// serviço de domínio/auditoria, não no banco.
  objeto_id            String?  @db.Uuid
  /// DST-E010 (fechado): ERP_CONTABIL | DOCUMENTO_FISCAL | CNIS |
  /// FOLHA_PAGAMENTO | BANCO | INFORME_RENDIMENTOS | CARNE_LEAO |
  /// ENTRADA_MANUAL | API_GOVERNAMENTAL | OUTRO_SISTEMA. CHECK PostgreSQL
  /// obrigatório na migration futura (ADR-D010: TEXT + CHECK, não ENUM nativo).
  sistema_origem       String?  @db.Text
  identificador_origem String?  @db.VarChar(120)
  /// DST-GAP-013 — Enum/Ref aberto.
  papel_no_conflito    String?  @db.Text
  valor_hash           String?  @db.VarChar(128)
  /// MCD-F9007 (Errata controlada nº2 do ADR-001, ADR-D017) — momento do
  /// registro canônico no armazenamento CONTIFISC. Distinto de
  /// `sistema_origem`/`identificador_origem` acima, que são específicos do
  /// domínio de reconciliação (papel/fonte do item no conflito), não os
  /// campos transversais F9001/F9002 desta errata.
  registrado_em        DateTime @db.Timestamptz

  conflito_dado ConflitoDado @relation(fields: [conflito_dado_id], references: [id], onDelete: Cascade)

  @@index([objeto_id])
  @@index([sistema_origem, identificador_origem])
  @@map("conflito_dado_item")
}

// ============================================================================
// COT-OBJ-016 -> MCD-F8701..F8706 -> CDC-REV-001 -> DST-T020
// Revisão Técnica: decisão humana auditável.
//
// `objeto_revisado_id`/`tipo_objeto_revisado`: EXCEÇÃO POLIMÓRFICA
// CONTROLADA DE REVISÃO/AUDITORIA (domínio de revisão técnica humana) —
// estruturalmente do mesmo tipo que a exceção de `ConflitoDadoItem` (acima),
// mas conceitualmente distinta: aqui a referência é a um objeto/resultado
// sendo revisado (EqHop, ConflitoDado, ResultadoCalculo etc. — COT-001 V1.1
// COT-REL-117/118), não a um participante de conflito. NÃO existe FK
// PostgreSQL genérica para `objeto_revisado_id` — mesma razão física de
// ConflitoDadoItem. A integridade dessa referência é validada pela camada de
// domínio/aplicação e auditada, não pelo banco. `tipo_objeto_revisado`
// permanece Enum/Ref aberto (DST-GAP-010) enquanto o catálogo correspondente
// não for fechado — nenhum valor foi inventado.
//
// Identidade/autorização do revisor permanece BLOQUEADA até SEC-001/OBS-001
// (ADR-GAP-004) — nenhum usuario_id/revisor_id foi criado por inferência.
//
// Este padrão é PROIBIDO como mecanismo de ownership de Receita ou qualquer
// outro objeto financeiro/tributário — esses sempre usam FK real. Não
// generalizar esta exceção para nenhum outro model além de ConflitoDadoItem
// e RevisaoTecnica.
// ============================================================================
model RevisaoTecnica {
  id                   String   @id @db.Uuid
  /// Exceção polimórfica controlada de REVISÃO/AUDITORIA (sem FK) — ver
  /// comentário do model acima. Distinta da exceção de ConflitoDadoItem
  /// (RECONCILIAÇÃO), mesmo padrão estrutural.
  objeto_revisado_id   String   @db.Uuid
  /// DST-GAP-010 — Enum/Ref aberto. Obrigatório.
  tipo_objeto_revisado String   @db.Text
  /// DST-E006 (fechado): PENDENTE | APROVADO | REJEITADO | AJUSTE_SOLICITADO.
  /// CHECK PostgreSQL obrigatório na migration futura (ADR-D010).
  status_revisao       String   @db.Text
  justificativa        String?  @db.Text
  /// `ADR-GAP-008` (Errata controlada nº2 do ADR-001): MCD-F9007
  /// (`registrado_em`) NÃO foi materializado neste model. A equivalência
  /// semântica entre `revisado_em` (momento da revisão) e `registrado_em`
  /// (momento do registro canônico) não foi confirmada — não resolvido por
  /// inferência. `revisado_em` permanece como já estava, sem renomeação.
  revisado_em          DateTime @db.Timestamptz
  /// MCD-F10003 (SEC-CHANGE-REQUEST-001 V1.1, ADR-001 V1.1 ADR-D023) --
  /// carimbado pelo processo/contexto autenticado de quem realiza a revisao
  /// -- nunca inferido do objeto revisado (objeto_revisado_id/
  /// tipo_objeto_revisado). A identidade especifica do revisor permanece
  /// bloqueada (ADR-GAP-004), distinta do tenant_id da operacao. Imutavel.
  tenant_id            String   @db.Uuid

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Restrict)

  @@index([objeto_revisado_id])
  @@index([tenant_id])
  @@map("revisao_tecnica")
}

// ============================================================================
// DOM-SEC -- Seguranca (novo nesta revisao, SEC-CHANGE-REQUEST-001 V1.1)
// Todos os 5 models abaixo sao representacoes fisicas MINIMAS -- somente os
// campos ja aprovados por MCD-001 V1.4/CDC-001 V1.4. Nenhum atributo de
// autenticacao, sessao, ou detalhamento futuro e antecipado. CredencialAcesso
// (COT-OBJ-018), Sessao, PapelAcesso e Permissao permanecem SEM model --
// diferidos/nao-canonicos (SEC-CHANGE-REQUEST-001 V1.1).
// ============================================================================

// ============================================================================
// COT-OBJ-019 -> MCD-F10001 -> CDC-SEC-001 -> DST-T031
// Tenant: fronteira tecnica de isolamento, seguranca e propriedade logica
// dos dados. NAO representa PessoaFisica, PessoaJuridica, UnidadeEconomica,
// um usuario individual, nem necessariamente um cliente comercial
// (SEC-001 par.1). Representacao minima deliberada (ADR-D020) --
// detalhamento completo (nome, status) permanece bloqueado ate Change
// Request de autenticacao/RBAC (GAP-CDC-1.3-001). Nenhum atributo
// comercial/organizacional e adicionado.
// ============================================================================
model Tenant {
  id String @id @db.Uuid

  unidades_economicas UnidadeEconomica[]
  arquivos_origem     ArquivoOrigem[]
  conflitos_dado      ConflitoDado[]
  revisoes_tecnicas   RevisaoTecnica[]
  concessoes          ContaAcessoTenant[]

  @@map("tenant")
}

// ============================================================================
// COT-OBJ-020 -> MCD-F10006 -> CDC-SEC-002 -> DST-T032
// Evento de Auditoria de Seguranca: registro imutavel de evento de
// seguranca (login, falha de autenticacao, mudanca de permissao, elevacao
// de privilegio, acesso sensivel, override, operacao administrativa) --
// distinto de ConflitoDado/RevisaoTecnica (auditoria tributaria) e de log
// tecnico generico. Nao antecipa EVT-001 (arquitetura de eventos de
// dominio generica -- reconciliacao futura entre os dois fica para quando
// EVT-001 existir). Representacao minima deliberada (ADR-D029) -- ator,
// tenant, UE, operacao, objeto afetado, instante e resultado permanecem
// bloqueados (GAP-CDC-1.3-002), dependentes de Change Request de
// autenticacao/RBAC e, para o ator, de OBS-001. Tabela INSERT-only por
// convencao de aplicacao -- nenhum mecanismo de banco (trigger/REVOKE)
// impoe isso nesta etapa (ADR-001 V1.1 par.8; nao ha colunas que
// justifiquem protecao granular ainda).
// ============================================================================
model EventoAuditoriaSeguranca {
  id String @id @db.Uuid

  @@map("evento_auditoria_seguranca")
}

// ============================================================================
// COT-OBJ-017 -> MCD-F10007 -> CDC-SEC-005 -> DST-T021
// Conta de Acesso: identidade de autenticacao/autorizacao, separada da
// identidade tributaria (PessoaFisica/PessoaJuridica). Representacao minima
// deliberada (ADR-D025) -- NENHUM atributo de mecanismo de autenticacao e
// incorporado: sem email, senha, hash de senha, provider, OAuth, MFA,
// token, refresh token, sessao, ou qualquer campo especifico de Auth.js ou
// outro provedor. `tipo` (HUMANA/SERVICO, mencionado em SEC-001 par.13) nao
// aprovado por nenhum Change Request -- GAP-CDC-1.4-002, explicitamente
// diferido, nao incorporado por inferencia. CredencialAcesso (COT-OBJ-018)
// permanece integralmente diferido -- nenhum model correspondente existe;
// verificado que a incorporacao minima de ContaAcesso.id nao cria nenhuma
// necessidade estrutural nova para CredencialAcesso.
// ============================================================================
model ContaAcesso {
  id String @id @db.Uuid

  concessoes_tenant     ContaAcessoTenant[]
  restricoes_unidade_ec ContaAcessoUnidadeEconomica[]

  @@map("conta_acesso")
}

// ============================================================================
// COT-SUP-005 -> MCD-F10005,F10008,F10009,F10010 -> CDC-SEC-003 -> DST-T036
// Concessao de Acesso a Tenant: materializa N:N ContaAcesso <-> Tenant, com
// papel aberto. Nenhuma concessao e implicita (negar por padrao).
// Unicidade logica: no maximo uma concessao por par (ADR-C012).
// id/conta_acesso_id/tenant_id sao IMUTAVEIS (ADR-001 V1.1 par.13.2) --
// revogar uma concessao e excluir a linha, nunca repontar a FK (mesma
// filosofia de ReceitaDocumentoFiscal/DocumentoFiscalArquivoOrigem).
// Vigencia/status desta concessao NAO sao contratualizados
// (GAP-CDC-1.4-001) -- mencionados na descricao textual de COT-SUP-005
// (COT-001 V1.2 par.4) mas nunca aprovados por nenhum Change Request; nao
// incorporados por inferencia. Timestamps cobertos pelo mecanismo de
// metadados transversais na materializacao fisica (MCD-001 par.9), sem
// campo local dedicado.
// ============================================================================
model ContaAcessoTenant {
  id              String @id @db.Uuid
  conta_acesso_id String @db.Uuid
  tenant_id       String @db.Uuid
  /// DST-GAP-015 -- Enum/Ref aberto; catalogo de papeis de acesso ainda nao
  /// aprovado. Nao inventar lista fechada. Nenhum Prisma enum e criado.
  papel           String @db.Text

  conta_acesso ContaAcesso @relation(fields: [conta_acesso_id], references: [id], onDelete: Restrict)
  tenant       Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Restrict)

  /// ADR-C012 -- no maximo uma concessao por par (conta_acesso_id, tenant_id).
  @@unique([conta_acesso_id, tenant_id], map: "uq_conta_acesso_tenant")
  @@map("conta_acesso_tenant")
}

// ============================================================================
// COT-SUP-006 -> MCD-F10005,F10008,F10011,F10012 -> CDC-SEC-004 -> DST-T037
// Restricao de Acesso por Unidade Economica: materializa N:N opcional
// ContaAcesso <-> UnidadeEconomica. RESTRINGE o escopo ja concedido por
// ContaAcessoTenant -- NUNCA amplia, NUNCA substitui, NUNCA concede acesso
// implicito a outras UEs do mesmo tenant (CDC-REL-SEC-001). Quando existir
// ao menos uma linha para um par (ContaAcesso, Tenant), a autorizacao deve
// considerar exclusivamente as UEs explicitamente listadas.
// Unicidade logica: no maximo uma restricao por par (ADR-C013).
// id/conta_acesso_id/unidade_economica_id sao IMUTAVEIS.
//
// ADR-C014 (invariante estrutural obrigatorio, NAO implementado neste
// schema): toda linha desta tabela deve corresponder a uma linha de
// ContaAcessoTenant para o mesmo conta_acesso_id e o tenant_id da UE
// referenciada -- uma restricao sem concessao de Tenant correspondente e
// dado invalido e nunca concede acesso por si so. Este invariante NAO e
// expressavel por FK simples nem composta em Prisma nem em PostgreSQL
// declarativo -- exige uma CONSTRAINT TRIGGER cross-table (mesma classe de
// mecanismo ja validada empiricamente para ADR-C005, porem envolvendo um
// join de resolucao unidade_economica_id -> unidade_economica.tenant_id
// que ADR-C005 nao precisava fazer). SQL MANUAL PENDENTE DE PoC -- a
// trigger NAO existe neste arquivo nem em nenhuma migration; deve ser
// proposta, validada isoladamente em PostgreSQL descartavel (mesma
// metodologia de ADR-C005) e so entao incorporada a uma migration real
// (ADR-001 V1.1 par.5.2/par.5.3/par.19). Ate a PoC ser conduzida, a garantia
// equivalente e responsabilidade exclusiva da camada de aplicacao.
//
// `papel` permanece Enum/Ref aberto (DST-GAP-015) -- nenhum enum fechado.
// ============================================================================
model ContaAcessoUnidadeEconomica {
  id                   String @id @db.Uuid
  conta_acesso_id      String @db.Uuid
  unidade_economica_id String @db.Uuid
  /// DST-GAP-015 -- Enum/Ref aberto; catalogo de papeis de acesso ainda nao
  /// aprovado. Nao inventar lista fechada. Nenhum Prisma enum e criado.
  papel                String @db.Text

  conta_acesso      ContaAcesso      @relation(fields: [conta_acesso_id], references: [id], onDelete: Restrict)
  unidade_economica UnidadeEconomica @relation(fields: [unidade_economica_id], references: [id], onDelete: Restrict)

  /// ADR-C013 -- no maximo uma restricao por par (conta_acesso_id, unidade_economica_id).
  @@unique([conta_acesso_id, unidade_economica_id], map: "uq_conta_acesso_unidade_economica")
  @@map("conta_acesso_unidade_economica")
}
